# Where the backend (olljira-backend) is reachable.
# Production: full API URL used by the browser, e.g. https://api.example.com
# Leave unset to call /api on the same origin (reverse-proxied setups).
VITE_API_URL=

# Dev only: origin the Vite dev server proxies /api to.
VITE_API_ORIGIN=http://localhost:3000
